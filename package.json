{
  "name": "rpc-nyrrcly",
  "type": "module",
  "version": "4.0.7",
  "description": "RPC client for Discord (Fork of discord.js RPC)",
  "author": "snek <me@gus.host>",
  "license": "MIT",
  "homepage": "https://github.com/NyrrCly/RPC-NyrrCly#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NyrrCly/RPC-NyrrCly.git"
  },
  "bugs": {
    "url": "https://github.com/NyrrCly/RPC-NyrrCly/issues"
  },
  "keywords": [
    "discord",
    "rpc",
    "rich presence",
    "remote procedural call"
  ],
  "main": "src/index.js",
  "unpkg": "browser.js",
  "jsdelivr": "browser.js",
  "types": "index.d.ts",
  "scripts": {
    "lint": "eslint src test --ext=js",
    "docs": "mkdir -p docs-out && docgen --source src --output docs-out/master.json --jsdoc jsdoc.json --custom docgen.json",
    "example": "electron example/main.js",
    "prepublishOnly": "npm run lint"
  },
  "dependencies": {
    "node-fetch": "^3.3.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "discord.js-docgen": "github:discordjs/docgen",
    "electron": "^45.3.3",
    "eslint": "^10.15.0"
  },
  "browser": {
    "net": false,
    "ws": false,
    "uws": false,
    "erlpack": false,
    "electron": false,
    "register-scheme": false,
    "./src/transports/IPC.js": false
  }
}
